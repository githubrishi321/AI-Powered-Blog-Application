# ──────────────────────────────────────────────────────────────────────────────
# Blogify — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env or any real secrets to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Server Configuration
PORT=8000
NODE_ENV=development

# Database Connection (MongoDB local or MongoDB Atlas URI)
MONGO_URL=mongodb://localhost:27017/blogify

# Authentication & Security (Use strong, random strings in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
PASSWORD_SALT=your_password_salt_string
COOKIE_SECRET=your_cookie_signing_secret_string
SESSION_SECRET=your_session_secret_key_string

# Account Lockout Settings (Optional - Defaults: 5 attempts, 15 minutes)
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# AI Tone Converter (Groq API)
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Cloudinary (Persistent Cloud Storage for Blog Cover Images)
# Required in production; optional in development (falls back to local public/uploads)
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin User Seeding (Used by: npm run create-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_min_6_chars
ADMIN_NAME=Site Admin

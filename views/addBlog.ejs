<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("./partials/head") %>
    <title>Create New Blog - Blogify</title>
    <style>
      .tone-btn {
        border: 1px solid #dee2e6;
        background-color: white;
        color: #495057;
        font-size: 0.875rem;
        transition: all 0.2s ease;
      }
      .tone-btn:hover {
        background-color: #e9ecef;
      }
      .tone-btn.active {
        background-color: #6610f2;
        color: white;
        border-color: #6610f2;
      }
      .tone-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
    </style>
  </head>
  <body>
    <%- include("./partials/nav") %>
    
    <div class="container">
      <div class="main-content">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <div class="text-center mb-4">
              <h1 class="blog-title">
                <i class="fas fa-plus me-3"></i>Create New Blog
              </h1>
              <p class="hero-subtitle">Share your story with the world</p>
            </div>
            
            <% if (locals.error) { %>
              <div class="alert alert-danger" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <%= locals.error %>
              </div>
            <% } %>
            
            <div class="card">
              <div class="card-body p-4">
                <form action="/blog" method="POST" enctype="multipart/form-data">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                  <div class="mb-4">
                    <label for="coverImage" class="form-label">
                      <i class="fas fa-image me-2"></i>Cover Image
                    </label>
                    <input
                      type="file"
                      class="form-control"
                      id="coverImage"
                      name="coverImage"
                      accept="image/jpeg,image/png,image/webp,image/gif"
                      aria-describedby="coverImage"
                    />
                    <div class="form-text">
                      <i class="fas fa-info-circle me-1"></i>
                      Choose an image (JPEG, PNG, WebP, GIF - max 5MB) to make your blog more engaging (optional)
                    </div>
                  </div>
                  
                  <div class="mb-4">
                    <label for="title" class="form-label">
                      <i class="fas fa-heading me-2"></i>Blog Title
                    </label>
                    <input
                      type="text"
                      class="form-control"
                      id="title"
                      name="title"
                      placeholder="Enter your blog title"
                      required
                    />
                  </div>
                  
                  <div class="mb-4">
                    <label for="body" class="form-label">
                      <i class="fas fa-edit me-2"></i>Blog Content
                    </label>
                    <textarea
                      class="form-control"
                      id="body"
                      name="body"
                      rows="10"
                      placeholder="Write your story here..."
                      required
                    ></textarea>
                    <div class="form-text">
                      <i class="fas fa-lightbulb me-1"></i>
                      Share your thoughts, experiences, or knowledge with the community
                    </div>
                    
                    <!-- AI Tone Converter Buttons -->
                    <div class="mt-3 p-3 bg-light rounded border">
                      <p class="mb-2 text-muted fw-bold small"><i class="fas fa-magic me-1"></i>AI Tone Converter</p>
                      <div class="d-flex flex-wrap gap-2" id="tone-buttons">
                        <button type="button" class="btn rounded-pill tone-btn active" data-tone="original">Original</button>
                        <button type="button" class="btn rounded-pill tone-btn" data-tone="professional">Professional</button>
                        <button type="button" class="btn rounded-pill tone-btn" data-tone="casual">Casual</button>
                        <button type="button" class="btn rounded-pill tone-btn" data-tone="social">Social</button>
                        <button type="button" class="btn rounded-pill tone-btn" data-tone="polite">Polite</button>
                        <button type="button" class="btn rounded-pill tone-btn" data-tone="emojify">Emojify</button>
                      </div>
                      <div id="ai-error" class="text-danger small mt-2 d-none fw-bold"></div>
                    </div>
                  </div>
                  
                  <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                      <i class="fas fa-paper-plane me-2"></i>Publish Blog
                    </button>
                    <a href="/" class="btn btn-outline-secondary">
                      <i class="fas fa-arrow-left me-2"></i>Cancel
                    </a>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <%- include("./partials/scripts") %>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const textarea = document.querySelector("textarea[name='body']");
        const buttons = document.querySelectorAll(".tone-btn");
        const errorDiv = document.getElementById("ai-error");

        let originalText = "";

        buttons.forEach(button => {
          button.addEventListener("click", async function() {
            const selectedTone = this.getAttribute("data-tone");
            const currentText = textarea.value.trim();

            if (currentText.length < 10) {
              showError("Please write at least 10 characters before converting tone.");
              return;
            }

            errorDiv.classList.add("d-none");

            buttons.forEach(btn => btn.classList.remove("active"));
            this.classList.add("active");

            if (selectedTone === "original") {
              if (originalText !== "") {
                textarea.value = originalText;
              }
              return;
            }

            const originalButton = document.querySelector(".tone-btn[data-tone='original']");
            if (originalText === "") {
              originalText = currentText; 
            }

            const originalBtnText = this.innerText;
            buttons.forEach(btn => btn.disabled = true);
            this.innerText = "Converting...";

            try {
              const response = await fetch("/ai/tone", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json"
                },
                body: JSON.stringify({
                  text: originalText || currentText, 
                  tone: selectedTone
                })
              });

              const data = await response.json();

              if (!response.ok) {
                 throw new Error(data.error || "Something went wrong.");
              }

              textarea.value = data.result;

            } catch (error) {
              showError(error.message);
              this.classList.remove("active");
              originalButton.classList.add("active");
            } finally {
              buttons.forEach(btn => btn.disabled = false);
              this.innerText = originalBtnText;
            }
          });
        });

        textarea.addEventListener("input", () => {
          const activeButton = document.querySelector(".tone-btn.active");
          if (activeButton && activeButton.getAttribute("data-tone") === "original") {
            originalText = textarea.value;
          }
        });

        function showError(message) {
          errorDiv.innerText = message;
          errorDiv.classList.remove("d-none");
        }
      });
    </script>
  </body>
</html>
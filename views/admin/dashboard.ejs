<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <%- include('./partials/styles') %>
  <title>Dashboard — Admin | Blogify</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="admin-body">
<div class="admin-wrapper">
  <%- include('./partials/sidebar', { currentPage: 'dashboard' }) %>
  <div class="admin-main">
    <%- include('./partials/topbar', { pageTitle: 'Dashboard' }) %>
    <div class="admin-content">
      <%- include('./partials/flash') %>

      <!-- Stat Cards -->
      <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
          <div class="stat-card">
            <div class="stat-icon indigo"><i class="fas fa-users"></i></div>
            <div>
              <div class="stat-value"><%= stats.totalUsers %></div>
              <div class="stat-label">Total Users</div>
            </div>
          </div>
        </div>
        <div class="col-xl-3 col-md-6">
          <div class="stat-card">
            <div class="stat-icon green"><i class="fas fa-user-plus"></i></div>
            <div>
              <div class="stat-value"><%= stats.newUsers7 %></div>
              <div class="stat-label">New Users (7d)</div>
            </div>
          </div>
        </div>
        <div class="col-xl-3 col-md-6">
          <div class="stat-card">
            <div class="stat-icon blue"><i class="fas fa-newspaper"></i></div>
            <div>
              <div class="stat-value"><%= stats.totalBlogs %></div>
              <div class="stat-label">Total Blogs</div>
            </div>
          </div>
        </div>
        <div class="col-xl-3 col-md-6">
          <div class="stat-card">
            <div class="stat-icon orange"><i class="fas fa-comments"></i></div>
            <div>
              <div class="stat-value"><%= stats.totalComments %></div>
              <div class="stat-label">Total Comments</div>
            </div>
          </div>
        </div>
        <div class="col-xl-3 col-md-6">
          <div class="stat-card">
            <div class="stat-icon purple"><i class="fas fa-robot"></i></div>
            <div>
              <div class="stat-value"><%= stats.aiToday %></div>
              <div class="stat-label">AI Conversions Today</div>
            </div>
          </div>
        </div>
        <div class="col-xl-3 col-md-6">
          <div class="stat-card">
            <div class="stat-icon red"><i class="fas fa-exclamation-triangle"></i></div>
            <div>
              <div class="stat-value"><%= stats.failedLoginsToday %></div>
              <div class="stat-label">Failed Logins Today</div>
            </div>
          </div>
        </div>
        <div class="col-xl-3 col-md-6">
          <div class="stat-card">
            <div class="stat-icon teal"><i class="fas fa-user-check"></i></div>
            <div>
              <div class="stat-value"><%= stats.newUsers30 %></div>
              <div class="stat-label">New Users (30d)</div>
            </div>
          </div>
        </div>
        <div class="col-xl-3 col-md-6">
          <div class="stat-card">
            <div class="stat-icon pink"><i class="fas fa-ban"></i></div>
            <div>
              <div class="stat-value"><%= stats.bannedUsers %></div>
              <div class="stat-label">Banned Users</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Charts -->
      <div class="row g-3 mb-4">
        <div class="col-lg-8">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5><i class="fas fa-chart-line me-2 text-primary"></i>Activity (Last 30 Days)</h5>
            </div>
            <div class="admin-card-body">
              <canvas id="activityChart" height="100"></canvas>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5><i class="fas fa-robot me-2 text-purple"></i>AI Usage (30d)</h5>
            </div>
            <div class="admin-card-body">
              <canvas id="aiChart" height="190"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Data Tables -->
      <div class="row g-3">
        <div class="col-lg-4">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5><i class="fas fa-users me-2 text-primary"></i>Recent Users</h5>
              <a href="/admin/users" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="admin-card-body p-0">
              <% if (recentUsers.length === 0) { %>
                <p class="text-muted text-center py-4">No users yet.</p>
              <% } else { %>
              <table class="admin-table">
                <tbody>
                  <% recentUsers.forEach(u => { %>
                  <tr>
                    <td>
                      <div style="font-weight:600; font-size:0.875rem;"><%= u.fullName %></div>
                      <div style="font-size:0.78rem; color:#6b7280;"><%= u.email %></div>
                    </td>
                    <td>
                      <span class="badge badge-<%= u.role.toLowerCase() %>"><%= u.role %></span>
                    </td>
                    <td>
                      <a href="/admin/users/<%= u._id %>" class="btn btn-sm btn-outline-primary py-0 px-2">View</a>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5><i class="fas fa-newspaper me-2 text-blue"></i>Recent Blogs</h5>
              <a href="/admin/blogs" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="admin-card-body p-0">
              <% if (recentBlogs.length === 0) { %>
                <p class="text-muted text-center py-4">No blogs yet.</p>
              <% } else { %>
              <table class="admin-table">
                <tbody>
                  <% recentBlogs.forEach(b => { %>
                  <tr>
                    <td>
                      <div style="font-weight:600; font-size:0.875rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:140px;"><%= b.title %></div>
                      <div style="font-size:0.78rem; color:#6b7280;"><%= b.createdBy ? b.createdBy.fullName : 'Unknown' %></div>
                    </td>
                    <td>
                      <span class="badge badge-<%= b.status %>"><%= b.status %></span>
                    </td>
                    <td>
                      <a href="/admin/blogs/<%= b._id %>/edit" class="btn btn-sm btn-outline-primary py-0 px-2">Edit</a>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="admin-card">
            <div class="admin-card-header">
              <h5><i class="fas fa-exclamation-triangle me-2 text-red"></i>Recent Failed Logins</h5>
              <a href="/admin/login-activity?success=false" class="btn btn-sm btn-outline-danger">View All</a>
            </div>
            <div class="admin-card-body p-0">
              <% if (recentFailedLogins.length === 0) { %>
                <p class="text-muted text-center py-4">No failed logins.</p>
              <% } else { %>
              <table class="admin-table">
                <tbody>
                  <% recentFailedLogins.forEach(l => { %>
                  <tr>
                    <td>
                      <div style="font-weight:600; font-size:0.875rem;"><%= l.emailAttempted %></div>
                      <div style="font-size:0.78rem; color:#6b7280;"><%= l.ip %></div>
                    </td>
                    <td style="font-size:0.78rem; color:#6b7280;">
                      <%= new Date(l.createdAt).toLocaleString() %>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/scripts') %>
<script>
const labels = <%- chartLabels %>;
const signups = <%- signupsData %>;
const blogs   = <%- blogsData %>;
const aiData  = <%- aiData %>;

// Activity chart
new Chart(document.getElementById('activityChart'), {
  type: 'line',
  data: {
    labels,
    datasets: [
      { label: 'Signups', data: signups, borderColor: '#6366f1', backgroundColor: 'rgba(99,102,241,0.08)', tension: 0.3, fill: true, pointBackgroundColor: '#6366f1' },
      { label: 'New Blogs', data: blogs,  borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.08)', tension: 0.3, fill: true, pointBackgroundColor: '#10b981' },
    ]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { position: 'top', labels: { color: '#334155', font: { weight: '600' } } }
    },
    scales: {
      x: { ticks: { color: '#64748b' }, grid: { color: '#f1f5f9' } },
      y: { beginAtZero: true, ticks: { color: '#64748b', stepSize: 1 }, grid: { color: '#f1f5f9' } }
    }
  }
});

// AI chart
new Chart(document.getElementById('aiChart'), {
  type: 'bar',
  data: {
    labels: labels.slice(-14),
    datasets: [{ label: 'AI Conversions', data: aiData.slice(-14), backgroundColor: 'rgba(139,92,246,0.85)', borderRadius: 6 }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { display: false }
    },
    scales: {
      x: { ticks: { color: '#64748b' }, grid: { display: false } },
      y: { beginAtZero: true, ticks: { color: '#64748b', stepSize: 1 }, grid: { color: '#f1f5f9' } }
    }
  }
});
</script>
</body>
</html>


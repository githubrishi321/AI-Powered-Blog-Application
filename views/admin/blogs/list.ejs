<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <%- include('../partials/styles') %>
  <title>Blogs | Blogify Admin</title>
</head>
<body class="admin-body">
<div class="admin-wrapper">
  <%- include('../partials/sidebar', { currentPage: 'blogs' }) %>
  <div class="admin-main">
    <%- include('../partials/topbar', { pageTitle: 'Blogs' }) %>
    <div class="admin-content">
      <%- include('../partials/flash') %>

      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h4 class="mb-0">All Blogs</h4>
          <small class="text-muted"><%= total %> blog<%= total !== 1 ? 's' : '' %> found</small>
        </div>
      </div>

      <!-- Filters -->
      <div class="admin-card mb-4">
        <div class="admin-card-body">
          <form method="GET" action="/admin/blogs" class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
              <label class="form-label small fw-semibold">Search</label>
              <input
                type="text"
                name="search"
                class="form-control"
                placeholder="Search by title..."
                value="<%= query.search || '' %>"
              >
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label small fw-semibold">Type</label>
              <select name="type" class="form-select">
                <option value="" <%= !query.type ? 'selected' : '' %>>All Types</option>
                <option value="blog" <%= query.type === 'blog' ? 'selected' : '' %>>Blog</option>
                <option value="experience" <%= query.type === 'experience' ? 'selected' : '' %>>Experience</option>
              </select>
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label small fw-semibold">Status</label>
              <select name="status" class="form-select">
                <option value=""          <%= !query.status                  ? 'selected' : '' %>>All Status</option>
                <option value="published" <%= query.status === 'published'  ? 'selected' : '' %>>Published</option>
                <option value="hidden"    <%= query.status === 'hidden'     ? 'selected' : '' %>>Hidden</option>
                <option value="featured"  <%= query.status === 'featured'   ? 'selected' : '' %>>Featured</option>
              </select>
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label small fw-semibold">Verified</label>
              <select name="verified" class="form-select">
                <option value="" <%= !query.verified ? 'selected' : '' %>>All</option>
                <option value="verified" <%= query.verified === 'verified' ? 'selected' : '' %>>Verified</option>
                <option value="unverified" <%= query.verified === 'unverified' ? 'selected' : '' %>>Unverified</option>
              </select>
            </div>
            <div class="col-6 col-md-2">
              <label class="form-label small fw-semibold">Sort</label>
              <select name="sort" class="form-select">
                <option value="newest" <%= query.sort === 'newest' || !query.sort ? 'selected' : '' %>>Newest</option>
                <option value="oldest" <%= query.sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
                <option value="title"  <%= query.sort === 'title'  ? 'selected' : '' %>>Title</option>
              </select>
            </div>
            <div class="col-6 col-md-1 d-flex gap-1">
              <button type="submit" class="btn btn-primary w-100" title="Filter">
                <i class="fas fa-search"></i>
              </button>
              <a href="/admin/blogs" class="btn btn-outline-secondary" title="Reset">
                <i class="fas fa-times"></i>
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Bulk Actions + Table -->
      <div class="admin-card">
        <div class="admin-card-body p-0">
          <% if (blogs.length === 0) { %>
            <div class="text-center py-5">
              <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
              <h5 class="text-muted">No blogs found</h5>
              <p class="text-muted">Try adjusting your filters.</p>
            </div>
          <% } else { %>
            <form method="POST" action="/admin/blogs/bulk" id="bulkForm">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
              <!-- Bulk Action Bar -->
              <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                <div class="form-check mb-0">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="selectAllBlogs"
                    title="Select all"
                  >
                  <label class="form-check-label small" for="selectAllBlogs">Select all</label>
                </div>
                <select name="action" class="form-select form-select-sm w-auto">
                  <option value="">— Bulk Action —</option>
                  <option value="delete">Delete Selected</option>
                  <option value="hide">Hide Selected</option>
                  <option value="publish">Publish Selected</option>
                  <option value="verify">Verify Selected Experiences</option>
                  <option value="unverify">Unverify Selected Experiences</option>
                </select>
                <button
                  type="submit"
                  class="btn btn-sm btn-outline-danger btn-bulk-apply"
                >
                  <i class="fas fa-play me-1"></i>Apply
                </button>
              </div>

              <div class="table-responsive">
                <table class="admin-table table table-hover mb-0">
                  <thead>
                    <tr>
                      <th width="40"></th>
                      <th>Title</th>
                      <th>Type</th>
                      <th>Company</th>
                      <th>Author</th>
                      <th>Status</th>
                      <th>Date</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% blogs.forEach(function(b) { %>
                      <tr>
                        <td>
                          <div class="form-check mb-0">
                            <input
                              class="form-check-input blog-checkbox"
                              type="checkbox"
                              name="ids"
                              value="<%= b._id %>"
                            >
                          </div>
                        </td>
                        <td>
                          <div class="fw-semibold">
                            <%= b.title ? b.title.substring(0, 60) : '(No title)' %><%= b.title && b.title.length > 60 ? '…' : '' %>
                            <% if (b.isDemo) { %>
                              <span class="badge bg-secondary ms-1">Demo</span>
                            <% } %>
                          </div>
                          <% const listCover = resolveCoverUrl(b); %>
                          <% if (listCover && !listCover.includes('blog-placeholder.svg')) { %>
                            <small class="text-success"><i class="fas fa-image me-1"></i>Has cover</small>
                          <% } else { %>
                            <small class="text-muted"><i class="fas fa-image me-1"></i>No cover</small>
                          <% } %>
                        </td>
                        <td>
                          <% if (b.type === 'experience') { %>
                            <span class="badge bg-primary text-light">Experience</span>
                          <% } else { %>
                            <span class="badge bg-secondary text-light">Blog</span>
                          <% } %>
                        </td>
                        <td>
                          <% if (b.type === 'experience') { %>
                            <div class="small fw-semibold"><%= b.experience?.company?.name || '—' %></div>
                            <% if (b.experience?.verified) { %>
                              <span class="badge verified-badge" title="Verified: a Blogify moderator checked this experience. It is not a guarantee that every detail is correct.">
                                <i class="fas fa-check-circle me-1"></i>Verified
                              </span>
                            <% } %>
                          <% } else { %>
                            <span class="text-muted small">—</span>
                          <% } %>
                        </td>
                        <td>
                          <% if (b.createdBy) { %>
                            <div class="small">
                              <%= b.createdBy.fullName || '—' %>
                              <% if (b.experience?.anonymous) { %>
                                <span class="badge bg-secondary ms-1">Anonymous</span>
                              <% } %>
                            </div>
                            <small class="text-muted"><%= b.createdBy.email || '' %></small>
                          <% } else { %>
                            <span class="text-muted">Deleted user</span>
                          <% } %>
                        </td>
                        <td>
                          <% if (b.status === 'published') { %>
                            <span class="badge badge-published">Published</span>
                          <% } else if (b.status === 'hidden') { %>
                            <span class="badge badge-hidden">Hidden</span>
                          <% } else if (b.status === 'featured') { %>
                            <span class="badge badge-featured">Featured</span>
                          <% } else { %>
                            <span class="badge bg-secondary"><%= b.status %></span>
                          <% } %>
                        </td>
                        <td>
                          <small><%= b.createdAt ? new Date(b.createdAt).toLocaleDateString() : '—' %></small>
                        </td>
                        <td>
                          <div class="d-flex gap-2">
                            <a
                              href="/admin/blogs/<%= b._id %>/edit"
                              class="btn btn-sm btn-outline-secondary"
                              title="Edit"
                            >
                              <i class="fas fa-edit"></i>
                            </a>
                            <button
                              type="button"
                              class="btn btn-sm btn-outline-danger btn-delete-trigger"
                              data-url="/admin/blogs/<%= b._id %>/delete"
                              data-item-name="<%= b.title ? b.title.replace(/"/g, '&quot;') : '(No title)' %>"
                              data-item-type="blog"
                              title="Delete Blog"
                            >
                              <i class="fas fa-trash"></i>
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </form>

            <!-- Pagination -->
            <% if (pages > 1) { %>
              <div class="admin-pagination p-3">
                <% if (page > 1) { %>
                  <a href="?page=<%= page - 1 %>&search=<%= query.search || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || '' %>">
                    <i class="fas fa-chevron-left me-1"></i>Prev
                  </a>
                <% } %>
                <% for (let i = 1; i <= pages; i++) { %>
                  <% if (i === page) { %>
                    <span class="current"><%= i %></span>
                  <% } else { %>
                    <a href="?page=<%= i %>&search=<%= query.search || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || '' %>">
                      <%= i %>
                    </a>
                  <% } %>
                <% } %>
                <% if (page < pages) { %>
                  <a href="?page=<%= page + 1 %>&search=<%= query.search || '' %>&status=<%= query.status || '' %>&sort=<%= query.sort || '' %>">
                    Next<i class="fas fa-chevron-right ms-1"></i>
                  </a>
                <% } %>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>
<%- include('../../partials/scripts') %>
</body>
</html>

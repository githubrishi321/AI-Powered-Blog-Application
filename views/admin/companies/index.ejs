<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <title>Manage Companies - Admin - Blogify</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-wrapper">
    <%- include('../partials/sidebar', { currentPage: 'companies' }) %>

    <div class="admin-main">
      <%- include('../partials/topbar', { pageTitle: 'Companies' }) %>

      <div class="admin-content">
        <%- include('../partials/flash') %>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h4 class="mb-0">Companies Directory</h4>
            <small class="text-muted">Manage companies, aliases, slugs, and duplicate merges</small>
          </div>
        </div>

        <!-- Filter & Search Bar -->
        <div class="admin-card mb-4">
          <form method="GET" action="/admin/companies" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
              <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input
                  type="text"
                  name="search"
                  class="form-control"
                  placeholder="Search by name or alias..."
                  value="<%= search || '' %>"
                  maxlength="50"
                >
              </div>
            </div>
            <div class="col-auto">
              <button type="submit" class="btn btn-sm btn-primary">Search</button>
              <% if (search) { %>
                <a href="/admin/companies" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
              <% } %>
            </div>
            <div class="col text-end text-muted small">
              Found <%= total %> <%= total === 1 ? 'company' : 'companies' %>
            </div>
          </form>
        </div>

        <!-- Companies Table -->
        <div class="admin-card">
          <% if (!companies || companies.length === 0) { %>
            <div class="text-center py-5">
              <i class="fas fa-building fa-3x text-muted mb-3"></i>
              <h5>No companies found</h5>
              <p class="text-muted">Try adjusting your search criteria.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table admin-table align-middle mb-0">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Aliases</th>
                    <th class="text-center">Published</th>
                    <th class="text-center">Hidden</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% companies.forEach(function(c) { %>
                    <tr>
                      <td>
                        <a href="/admin/companies/<%= c._id %>" class="fw-semibold text-decoration-none">
                          <%= c.name %>
                        </a>
                        <% if (c.isDemo) { %>
                          <span class="badge bg-secondary ms-1">Demo</span>
                        <% } %>
                      </td>
                      <td>
                        <code><%= c.slug %></code>
                      </td>
                      <td>
                        <% if (c.aliases && c.aliases.length > 0) { %>
                          <% c.aliases.slice(0, 3).forEach(function(a) { %>
                            <span class="badge bg-light text-dark border me-1"><%= a %></span>
                          <% }); %>
                          <% if (c.aliases.length > 3) { %>
                            <small class="text-muted">+<%= c.aliases.length - 3 %> more</small>
                          <% } %>
                        <% } else { %>
                          <span class="text-muted small">—</span>
                        <% } %>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-success-subtle text-success"><%= c.publishedCount %></span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-secondary-subtle text-secondary"><%= c.hiddenCount %></span>
                      </td>
                      <td>
                        <% if (c.mergedInto) { %>
                          <span class="badge bg-warning-subtle text-warning">
                            <i class="fas fa-code-branch me-1"></i>Merged into <%= c.mergedInto.name %>
                          </span>
                        <% } else { %>
                          <span class="badge bg-success-subtle text-success">
                            <i class="fas fa-check-circle me-1"></i>Active
                          </span>
                        <% } %>
                      </td>
                      <td class="text-end">
                        <a href="/admin/companies/<%= c._id %>" class="btn btn-sm btn-outline-primary">
                          <i class="fas fa-cog me-1"></i>Manage
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <!-- Pagination -->
            <% if (pages > 1) { %>
              <div class="admin-pagination p-3 d-flex justify-content-between align-items-center border-top">
                <span class="small text-muted">Page <%= page %> of <%= pages %></span>
                <div class="d-flex gap-1">
                  <% if (page > 1) { %>
                    <a href="?page=<%= page - 1 %>&search=<%= search || '' %>" class="btn btn-sm btn-outline-secondary">
                      <i class="fas fa-chevron-left me-1"></i>Prev
                    </a>
                  <% } %>
                  <% if (page < pages) { %>
                    <a href="?page=<%= page + 1 %>&search=<%= search || '' %>" class="btn btn-sm btn-outline-secondary">
                      Next<i class="fas fa-chevron-right ms-1"></i>
                    </a>
                  <% } %>
                </div>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</body>
</html>


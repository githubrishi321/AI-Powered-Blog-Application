<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <%- include('../partials/styles') %>
  <title>Security Audit Trail | Blogify Admin</title>
</head>
<body class="admin-body">
<div class="admin-wrapper">
  <%- include('../partials/sidebar', { currentPage: 'auditLog' }) %>
  <div class="admin-main">
    <%- include('../partials/topbar', { pageTitle: 'System Audit Trail' }) %>
    <div class="admin-content">
      <%- include('../partials/flash') %>

      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h4 class="mb-0">Immutable Audit Trail</h4>
          <small class="text-muted"><%= total %> administrative action<%= total !== 1 ? 's' : '' %> recorded</small>
        </div>
        <span class="badge badge-admin py-2 px-3">
          <i class="fas fa-lock me-1"></i>Tamper-Proof UI (Read-Only)
        </span>
      </div>

      <!-- Filters -->
      <div class="admin-card mb-4">
        <div class="admin-card-body">
          <form method="GET" action="/admin/audit-log" class="row g-3 align-items-end">
            <div class="col-md-5">
              <label class="form-label small fw-semibold">Action Search</label>
              <input type="text" name="action" class="form-control" placeholder="e.g. user.ban, blog.delete..." value="<%= query.action || '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Target Entity Type</label>
              <select name="targetType" class="form-select">
                <option value="" <%= !query.targetType ? 'selected' : '' %>>All Entity Types</option>
                <option value="user" <%= query.targetType === 'user' ? 'selected' : '' %>>User</option>
                <option value="blog" <%= query.targetType === 'blog' ? 'selected' : '' %>>Blog</option>
                <option value="comment" <%= query.targetType === 'comment' ? 'selected' : '' %>>Comment</option>
                <option value="settings" <%= query.targetType === 'settings' ? 'selected' : '' %>>Settings</option>
                <option value="aiConfig" <%= query.targetType === 'aiConfig' ? 'selected' : '' %>>AI Config</option>
              </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
              <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-search me-1"></i>Filter
              </button>
              <a href="/admin/audit-log" class="btn btn-outline-secondary">
                <i class="fas fa-times"></i>
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Table -->
      <div class="admin-card">
        <div class="admin-card-body p-0">
          <% if (logs.length === 0) { %>
            <div class="text-center py-5">
              <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
              <h5 class="text-muted">No audit logs found</h5>
              <p class="text-muted">Administrative write actions will automatically be tracked here.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="admin-table table table-hover mb-0">
                <thead>
                  <tr>
                    <th>Timestamp</th>
                    <th>Admin</th>
                    <th>Action</th>
                    <th>Target</th>
                    <th>Changes (Before &rarr; After)</th>
                    <th>IP</th>
                  </tr>
                </thead>
                <tbody>
                  <% logs.forEach(log => { %>
                    <tr>
                      <td class="small text-muted" style="white-space: nowrap;">
                        <%= new Date(log.createdAt).toLocaleString() %>
                      </td>
                      <td>
                        <span class="fw-semibold small"><%= log.adminEmail || (log.admin ? log.admin.email : 'Deleted user') %></span>
                      </td>
                      <td>
                        <span class="badge badge-admin font-monospace"><%= log.action %></span>
                      </td>
                      <td>
                        <span class="badge badge-user text-uppercase"><%= log.targetType || 'general' %></span>
                        <% if (log.targetLabel) { %>
                          <div class="small text-truncate mt-1" style="max-width: 180px;" title="<%= log.targetLabel %>">
                            <%= log.targetLabel %>
                          </div>
                        <% } %>
                      </td>
                      <td style="max-width: 320px;">
                        <% if (log.before || log.after) { %>
                          <details class="small">
                            <summary class="text-primary text-decoration-underline" style="cursor: pointer;">View Change Diff</summary>
                            <div class="p-2 bg-light rounded mt-1 font-monospace" style="font-size: 0.75rem; max-height: 150px; overflow-y: auto;">
                              <% if (log.before) { %>
                                <div class="text-danger"><strong>Before:</strong> <%= JSON.stringify(log.before, null, 2) %></div>
                              <% } %>
                              <% if (log.after) { %>
                                <div class="text-success mt-1"><strong>After:</strong> <%= JSON.stringify(log.after, null, 2) %></div>
                              <% } %>
                            </div>
                          </details>
                        <% } else { %>
                          <span class="text-muted small">—</span>
                        <% } %>
                      </td>
                      <td>
                        <span class="font-monospace small text-muted"><%= log.ip || '—' %></span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Pagination -->
      <% if (pages > 1) { %>
        <div class="admin-pagination">
          <% if (page > 1) { %>
            <a href="?page=<%= page - 1 %>&action=<%= query.action || '' %>&targetType=<%= query.targetType || '' %>">
              <i class="fas fa-chevron-left me-1"></i>Prev
            </a>
          <% } %>
          <% for (let i = 1; i <= pages; i++) { %>
            <% if (i === page) { %>
              <span class="current"><%= i %></span>
            <% } else if (i === 1 || i === pages || (i >= page - 2 && i <= page + 2)) { %>
              <a href="?page=<%= i %>&action=<%= query.action || '' %>&targetType=<%= query.targetType || '' %>"><%= i %></a>
            <% } else if (i === page - 3 || i === page + 3) { %>
              <span class="px-2 text-muted">…</span>
            <% } %>
          <% } %>
          <% if (page < pages) { %>
            <a href="?page=<%= page + 1 %>&action=<%= query.action || '' %>&targetType=<%= query.targetType || '' %>">
              Next<i class="fas fa-chevron-right ms-1"></i>
            </a>
          <% } %>
        </div>
      <% } %>

    </div>
  </div>
</div>

<%- include('../../partials/scripts') %>
</body>
</html>


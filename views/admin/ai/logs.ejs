<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <%- include('../partials/styles') %>
  <title>AI Usage Logs | Blogify Admin</title>
</head>
<body class="admin-body">
<div class="admin-wrapper">
  <%- include('../partials/sidebar', { currentPage: 'ai' }) %>
  <div class="admin-main">
    <%- include('../partials/topbar', { pageTitle: 'AI Usage Logs' }) %>
    <div class="admin-content">
      <%- include('../partials/flash') %>

      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h4 class="mb-0">AI Conversion Logs</h4>
          <small class="text-muted"><%= total %> log entry<%= total !== 1 ? 's' : '' %> found</small>
        </div>
        <a href="/admin/ai" class="btn btn-outline-primary">
          <i class="fas fa-sliders-h me-2"></i>AI Settings
        </a>
      </div>

      <!-- Filters -->
      <div class="admin-card mb-4">
        <div class="admin-card-body">
          <form method="GET" action="/admin/ai/logs" class="row g-3 align-items-end">
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Tone</label>
              <select name="tone" class="form-select">
                <option value="all" <%= query.tone === 'all' || !query.tone ? 'selected' : '' %>>All Tones</option>
                <% tones.forEach(t => { %>
                  <option value="<%= t %>" <%= query.tone === t ? 'selected' : '' %>><%= t %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Status</label>
              <select name="status" class="form-select">
                <option value="all" <%= query.status === 'all' || !query.status ? 'selected' : '' %>>All Statuses</option>
                <option value="success" <%= query.status === 'success' ? 'selected' : '' %>>Success</option>
                <option value="error" <%= query.status === 'error' ? 'selected' : '' %>>Error</option>
                <option value="blocked" <%= query.status === 'blocked' ? 'selected' : '' %>>Blocked</option>
              </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
              <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-filter me-1"></i>Filter
              </button>
              <a href="/admin/ai/logs" class="btn btn-outline-secondary">
                <i class="fas fa-times"></i>
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Table -->
      <div class="admin-card">
        <div class="admin-card-body p-0">
          <% if (logs.length === 0) { %>
            <div class="text-center py-5">
              <i class="fas fa-robot fa-3x text-muted mb-3"></i>
              <h5 class="text-muted">No AI activity found</h5>
              <p class="text-muted">No conversion attempts match your query.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="admin-table table table-hover mb-0">
                <thead>
                  <tr>
                    <th>User</th>
                    <th>Tone</th>
                    <th>Input Chars</th>
                    <th>Status</th>
                    <th>Latency</th>
                    <th>Timestamp</th>
                  </tr>
                </thead>
                <tbody>
                  <% logs.forEach(log => { %>
                    <tr>
                      <td>
                        <% if (log.user) { %>
                          <a href="/admin/users/<%= log.user._id %>" class="fw-semibold text-decoration-none">
                            <%= log.user.fullName || log.user.email %>
                          </a>
                          <div class="small text-muted"><%= log.user.email %></div>
                        <% } else { %>
                          <span class="text-muted font-monospace">Anonymous</span>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge badge-featured text-uppercase"><%= log.tone %></span>
                      </td>
                      <td>
                        <span class="font-monospace"><%= log.inputLength || 0 %> chars</span>
                      </td>
                      <td>
                        <span class="badge badge-<%= log.status %>"><%= log.status %></span>
                      </td>
                      <td>
                        <span class="text-muted small"><%= log.latencyMs ? log.latencyMs + ' ms' : '—' %></span>
                      </td>
                      <td>
                        <span class="text-muted small"><%= new Date(log.createdAt).toLocaleString() %></span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Pagination -->
      <% if (pages > 1) { %>
        <div class="admin-pagination">
          <% if (page > 1) { %>
            <a href="?page=<%= page - 1 %>&tone=<%= query.tone || '' %>&status=<%= query.status || '' %>">
              <i class="fas fa-chevron-left me-1"></i>Prev
            </a>
          <% } %>
          <% for (let i = 1; i <= pages; i++) { %>
            <% if (i === page) { %>
              <span class="current"><%= i %></span>
            <% } else if (i === 1 || i === pages || (i >= page - 2 && i <= page + 2)) { %>
              <a href="?page=<%= i %>&tone=<%= query.tone || '' %>&status=<%= query.status || '' %>"><%= i %></a>
            <% } else if (i === page - 3 || i === page + 3) { %>
              <span class="px-2 text-muted">…</span>
            <% } %>
          <% } %>
          <% if (page < pages) { %>
            <a href="?page=<%= page + 1 %>&tone=<%= query.tone || '' %>&status=<%= query.status || '' %>">
              Next<i class="fas fa-chevron-right ms-1"></i>
            </a>
          <% } %>
        </div>
      <% } %>

    </div>
  </div>
</div>

<%- include('../../partials/scripts') %>
</body>
</html>


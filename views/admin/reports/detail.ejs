<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <%- include('../partials/styles') %>
  <title>Review Experience #<%= blog._id %> | Blogify Admin</title>
  <script src="/js/admin-moderation.js" defer></script>
</head>
<body class="admin-body">
<div class="admin-wrapper">
  <%- include('../partials/sidebar', { currentPage: 'reports' }) %>
  <div class="admin-main">
    <%- include('../partials/topbar', { pageTitle: 'Review Report' }) %>
    <div class="admin-content">
      <%- include('../partials/flash') %>

      <!-- Top Navigation & Back -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <a href="/admin/reports" class="btn btn-sm btn-outline-secondary mb-2">
            <i class="fas fa-arrow-left me-1"></i>Back to Report Queue
          </a>
          <h4 class="mb-0">Moderation Review</h4>
          <small class="text-muted">Post ID: <%= blog._id %></small>
        </div>
        <div class="d-flex gap-2">
          <% if (blog.status === 'published' || blog.status === 'featured') { %>
            <a href="/experiences/<%= blog._id %>" target="_blank" class="btn btn-outline-primary btn-sm">
              <i class="fas fa-external-link-alt me-1"></i>View Live Page
            </a>
          <% } %>
        </div>
      </div>

      <!-- Action Toolbar Card -->
      <div class="admin-card mb-4 border-start border-4 border-primary">
        <div class="admin-card-body">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
              <span class="fw-bold me-2"><i class="fas fa-gavel text-primary me-1"></i>Moderator Actions:</span>
              <span class="text-muted small">Conditional and audit-logged operations</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <% if (openReportsCount > 0) { %>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#dismissModal">
                  <i class="fas fa-check-double me-1"></i>Dismiss Open Reports (<%= openReportsCount %>)
                </button>
              <% } %>

              <% if (blog.status === 'hidden') { %>
                <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#publishModal">
                  <i class="fas fa-globe me-1"></i>Publish Post
                </button>
              <% } else { %>
                <button type="button" class="btn btn-sm btn-warning text-dark" data-bs-toggle="modal" data-bs-target="#hideModal">
                  <i class="fas fa-eye-slash me-1"></i>Hide Post
                </button>
              <% } %>

              <% if (blog.status === 'featured') { %>
                <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#unfeatureModal">
                  <i class="fas fa-star-half-alt me-1"></i>Unfeature
                </button>
              <% } else if (blog.status === 'published') { %>
                <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#featureModal">
                  <i class="fas fa-star me-1"></i>Feature
                </button>
              <% } %>

              <% if (blog.verified) { %>
                <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#unverifyModal">
                  <i class="fas fa-times-circle me-1"></i>Unverify
                </button>
              <% } else { %>
                <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#verifyModal">
                  <i class="fas fa-check-circle me-1"></i>Verify Badge
                </button>
              <% } %>

              <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                <i class="fas fa-trash me-1"></i>Delete Post
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Experience Overview Card -->
      <div class="admin-card mb-4">
        <div class="admin-card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="fas fa-file-alt me-2 text-primary"></i>Experience Details</h5>
          <div>
            <% if (blog.status === 'published') { %>
              <span class="badge badge-published">Published</span>
            <% } else if (blog.status === 'hidden') { %>
              <span class="badge badge-hidden">Hidden</span>
            <% } else if (blog.status === 'featured') { %>
              <span class="badge badge-featured">Featured</span>
            <% } %>

            <% if (blog.verified) { %>
              <span class="badge verified-badge ms-1" title="Verified: a Blogify moderator checked this experience. It is not a guarantee that every detail is correct.">
                <i class="fas fa-check-circle me-1"></i>Verified
              </span>
            <% } %>
          </div>
        </div>
        <div class="admin-card-body">
          <h4 class="fw-bold mb-3"><%= blog.title %></h4>

          <!-- Author Transparency Section -->
          <div class="p-3 bg-light rounded-3 mb-4 border">
            <div class="d-flex align-items-center">
              <i class="fas fa-user-shield fa-2x text-primary me-3"></i>
              <div>
                <div class="fw-bold">
                  Author Identity (Moderator Transparency):
                  <% if (blog.anonymous) { %>
                    <span class="badge bg-secondary ms-2"><i class="fas fa-user-secret me-1"></i>Anonymous to the public</span>
                  <% } else { %>
                    <span class="badge bg-light text-dark border ms-2"><i class="fas fa-globe me-1"></i>Public author</span>
                  <% } %>
                </div>
                <div class="small text-muted mt-1">
                  <strong>Real Name:</strong> <%= blog.authorRealName %> &bull;
                  <strong>Real Email:</strong> <%= blog.authorRealEmail %>
                </div>
              </div>
            </div>
          </div>

          <!-- Moderation Status Notice if Hidden -->
          <% if (blog.status === 'hidden' && blog.moderationReason) { %>
            <div class="alert alert-warning mb-4">
              <div class="fw-bold"><i class="fas fa-eye-slash me-1"></i>Hidden by moderators: <%= blog.moderationReason %></div>
              <% if (blog.moderationNote) { %>
                <div class="small mt-1 pre-wrap-text"><%= blog.moderationNote %></div>
              <% } %>
            </div>
          <% } %>

          <!-- Metadata Badges -->
          <div class="row g-3 mb-4">
            <div class="col-md-3">
              <div class="small text-muted">Company</div>
              <div class="fw-semibold"><%= blog.companyName %></div>
            </div>
            <div class="col-md-3">
              <div class="small text-muted">Role & Year</div>
              <div class="fw-semibold"><%= blog.role %> (<%= blog.year %>)</div>
            </div>
            <div class="col-md-3">
              <div class="small text-muted">Drive Type</div>
              <div class="fw-semibold text-capitalize"><%= blog.driveType %></div>
            </div>
            <div class="col-md-3">
              <div class="small text-muted">Outcome & Difficulty</div>
              <div class="fw-semibold text-capitalize">
                <%= blog.outcome %> &bull; Diff: <%= blog.difficulty %>/5
              </div>
            </div>
          </div>

          <!-- Body / Story -->
          <% if (blog.body) { %>
            <div class="mb-4">
              <h6 class="fw-bold text-uppercase text-muted small">Interview Story</h6>
              <div class="p-3 bg-light rounded pre-wrap-text"><%= blog.body %></div>
            </div>
          <% } %>

          <!-- Rounds -->
          <% if (blog.rounds && blog.rounds.length > 0) { %>
            <div class="mb-4">
              <h6 class="fw-bold text-uppercase text-muted small">Interview Rounds (<%= blog.rounds.length %>)</h6>
              <div class="list-group">
                <% blog.rounds.forEach(function(round, idx) { %>
                  <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="fw-semibold">Round <%= round.roundNumber || (idx + 1) %>: <%= round.name || round.type %></span>
                      <span class="badge bg-secondary text-capitalize"><%= round.type %></span>
                    </div>
                    <% if (round.duration) { %>
                      <div class="small text-muted mb-2"><i class="far fa-clock me-1"></i>Duration: <%= round.duration %></div>
                    <% } %>
                    <% if (round.description) { %>
                      <div class="small pre-wrap-text mb-2"><%= round.description %></div>
                    <% } %>
                    <% if (round.questions && round.questions.length > 0) { %>
                      <div class="small fw-semibold text-muted">Questions asked:</div>
                      <ul class="small mb-0 ps-3">
                        <% round.questions.forEach(function(q) { %>
                          <li><div class="pre-wrap-text"><%= q %></div></li>
                        <% }); %>
                      </ul>
                    <% } %>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- Preparation Tips -->
          <% if (blog.tips) { %>
            <div>
              <h6 class="fw-bold text-uppercase text-muted small">Preparation Tips</h6>
              <div class="p-3 bg-light rounded pre-wrap-text"><%= blog.tips %></div>
            </div>
          <% } %>

        </div>
      </div>

      <!-- Filed Reports Section -->
      <div class="admin-card mb-4">
        <div class="admin-card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="fas fa-flag me-2 text-danger"></i>Filed Reports (<%= reports.length %>)</h5>
          <% if (openReportsCount > 0) { %>
            <span class="badge bg-danger"><%= openReportsCount %> Open Report<%= openReportsCount !== 1 ? 's' : '' %></span>
          <% } else { %>
            <span class="badge bg-success">All Reports Resolved</span>
          <% } %>
        </div>
        <div class="admin-card-body p-0">
          <% if (reports.length === 0) { %>
            <div class="text-center py-4">
              <p class="text-muted mb-0">No reports found for this experience.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="admin-table table table-hover mb-0">
                <thead>
                  <tr>
                    <th>Reporter</th>
                    <th>Reason</th>
                    <th>Note</th>
                    <th>Date</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% reports.forEach(function(r) { %>
                    <tr>
                      <td>
                        <div class="fw-semibold"><%= r.reporterName %></div>
                        <small class="text-muted"><%= r.reporterEmail %></small>
                      </td>
                      <td>
                        <span class="badge bg-warning text-dark text-capitalize"><%= r.reason %></span>
                      </td>
                      <td>
                        <% if (r.note) { %>
                          <div class="pre-wrap-text"><%= r.note %></div>
                        <% } else { %>
                          <span class="text-muted small">—</span>
                        <% } %>
                      </td>
                      <td>
                        <small><%= r.createdAt ? new Date(r.createdAt).toLocaleString() : '—' %></small>
                      </td>
                      <td>
                        <% if (r.status === 'open') { %>
                          <span class="badge bg-danger">Open</span>
                        <% } else if (r.status === 'resolved') { %>
                          <span class="badge bg-success">Resolved</span>
                          <% if (r.resolvedByName) { %>
                            <div class="small text-muted">by <%= r.resolvedByName %></div>
                          <% } %>
                        <% } else { %>
                          <span class="badge bg-secondary text-capitalize"><%= r.status %></span>
                          <% if (r.resolvedByName) { %>
                            <div class="small text-muted">by <%= r.resolvedByName %></div>
                          <% } %>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- ─── Modals (No Inline JS, Wired with Bootstrap & admin-moderation.js) ─── -->

<!-- Dismiss Reports Modal -->
<div class="modal fade" id="dismissModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/reports/<%= blog._id %>/dismiss">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title">Dismiss Open Reports</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to dismiss all open reports on this post? They will be marked as dismissed and removed from the active queue.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Confirm Dismiss</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Hide Experience Modal -->
<div class="modal fade" id="hideModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/reports/<%= blog._id %>/hide">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title">Hide Experience</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small">This post will be hidden from public listings and company statistics. The author will see the reason when viewing their post.</p>
          <div class="mb-3">
            <label class="form-label fw-semibold">Moderation Reason <span class="text-danger">*</span></label>
            <select name="reason" class="form-select" required>
              <option value="" disabled selected>— Select reason —</option>
              <option value="spam">Spam</option>
              <option value="promotional">Promotional</option>
              <option value="personal-info">Personal Contact Info</option>
              <option value="abusive">Abusive / Inappropriate</option>
              <option value="fake">Fake / Fabricated</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="mb-3">
            <div class="d-flex justify-content-between">
              <label class="form-label fw-semibold">Moderator Note (Optional)</label>
              <span class="small text-muted" id="hideCharCount">0 / 200</span>
            </div>
            <textarea name="note" id="hideNoteInput" class="form-control" rows="3" maxlength="200" placeholder="Optional explanation visible to the post author (max 200 chars)..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning text-dark">Confirm Hide</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Publish Experience Modal -->
<div class="modal fade" id="publishModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/reports/<%= blog._id %>/publish">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title">Publish Experience</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>Publish this experience? It will become publicly visible on browse listings and company pages, and any existing moderation hide reason will be cleared.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Confirm Publish</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Feature Experience Modal -->
<div class="modal fade" id="featureModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/reports/<%= blog._id %>/feature">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title">Feature Experience</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>Feature this experience? It will receive prominent placement and a featured badge.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info">Confirm Feature</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Unfeature Experience Modal -->
<div class="modal fade" id="unfeatureModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/reports/<%= blog._id %>/unfeature">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title">Unfeature Experience</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>Remove featured status from this experience? It will return to standard published status.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-outline-info">Confirm Unfeature</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Verify Experience Modal -->
<div class="modal fade" id="verifyModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/reports/<%= blog._id %>/verify">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title">Verify Experience</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>Mark this experience as Verified? A verified checkmark badge will be displayed across browse and company pages indicating a moderator checked this experience.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Confirm Verify</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Unverify Experience Modal -->
<div class="modal fade" id="unverifyModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/reports/<%= blog._id %>/unverify">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title">Remove Verified Badge</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>Remove the verified badge from this experience?</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning text-dark">Confirm Remove Verification</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Delete Experience Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/reports/<%= blog._id %>/delete">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title text-danger"><i class="fas fa-exclamation-triangle me-1"></i>Delete Experience</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-danger fw-bold">Warning: This action cannot be undone.</p>
          <p>Deleting this experience will cascade delete all its comments, associated reports, and storage cover images.</p>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Type <span class="text-danger fw-bold">DELETE</span> to confirm:</label>
            <input type="text" name="confirmation" id="deleteConfirmInput" class="form-control" autocomplete="off" placeholder="DELETE">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" id="deleteConfirmSubmit" class="btn btn-danger" disabled>Permanently Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>

</body>
</html>


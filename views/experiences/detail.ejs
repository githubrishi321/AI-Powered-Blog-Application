<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <!-- Title strictly excludes author name for anonymity compliance -->
  <title><%= experience.title %> - Interview Experience</title>
  <% if (experience.isDemo) { %>
    <meta name="robots" content="noindex">
  <% } %>
</head>
<body>
  <%- include("../partials/nav") %>

  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-lg-9">

        <!-- Hidden Banner (visible only to Owner or Admin) -->
        <% if (isHidden) { %>
          <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-eye-slash fa-lg me-3"></i>
            <div>
              <% if (experience.moderationReason) { %>
                <strong>Hidden by moderators: <%= experience.moderationReason %></strong>
                <% if (experience.moderationNote) { %>
                  <div class="mt-1"><%= experience.moderationNote %></div>
                <% } %>
              <% } else { %>
                <strong>Hidden by moderators.</strong>
                <% if (experience.moderationNote) { %>
                  <div class="mt-1"><%= experience.moderationNote %></div>
                <% } %>
              <% } %>
            </div>
          </div>
        <% } %>

        <!-- Owner Private Notice if Anonymous -->
        <% if (isOwner && isAnonymous) { %>
          <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-user-secret fa-lg me-3"></i>
            <div>
              <strong>Posted Anonymously:</strong> Only you and admins can see you posted this. To all other visitors and students, you are displayed as "Anonymous Student".
            </div>
          </div>
        <% } %>

        <!-- Header Card -->
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body p-4 p-md-5">
            <!-- Badges Bar -->
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
              <span class="badge bg-light text-dark border">
                <i class="fas fa-briefcase me-1"></i><%= experience.experience?.driveType || 'Drive' %>
              </span>
              <span class="badge badge-outcome-<%= experience.experience?.outcome || 'undisclosed' %>">
                Outcome: <%= experience.experience?.outcome || 'Undisclosed' %>
              </span>
              <span class="badge bg-secondary">
                Difficulty: <%= experience.experience?.difficulty || '—' %> / 5
              </span>
              <% if (experience.experience?.verified) { %>
                <span class="badge verified-badge" title="Verified: a Blogify moderator checked this experience. It is not a guarantee that every detail is correct.">
                  <i class="fas fa-check-circle me-1"></i>Verified Experience
                </span>
              <% } %>
              <% if (experience.isDemo) { %>
                <span class="badge bg-secondary text-light">Demo</span>
              <% } %>
            </div>

            <!-- Title & Company -->
            <h1 class="h2 fw-bold text-dark mb-2">
              <%= experience.title %>
            </h1>

            <div class="text-muted mb-4 fs-5">
              <span>Company: <strong>
                <% if (experience.experience?.company?.slug) { %>
                  <a href="/company/<%= experience.experience.company.slug %>" class="text-decoration-none text-dark hover-primary"><%= experience.experience.company.name %></a>
                <% } else { %>
                  <%= experience.experience?.company?.name || 'Company' %>
                <% } %>
              </strong></span>
              <span class="mx-2">&bull;</span>
              <span>Role: <strong><%= experience.experience?.role %></strong></span>
              <span class="mx-2">&bull;</span>
              <span>Year: <strong><%= experience.experience?.year %></strong></span>
            </div>

            <!-- Author & Metadata Block -->
            <!-- Author & Metadata Block with Action Buttons -->
            <div class="d-flex flex-wrap justify-content-between align-items-center border-top pt-3 gap-3">
              <div class="d-flex align-items-center">
                <img
                  src="<%= publicAuthor.avatar %>"
                  alt="Author"
                  class="rounded-circle me-3 avatar-img"
                  width="44"
                  height="44"
                >
                <div>
                  <div class="fw-bold">
                    <%= publicAuthor.name %>
                    <% if (isAnonymous) { %>
                      <span class="badge bg-light text-muted border ms-1">Anonymous</span>
                    <% } %>
                  </div>
                  <small class="text-muted">
                    <i class="fas fa-calendar-alt me-1"></i>
                    <%= new Date(experience.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                  </small>
                </div>
              </div>

              <!-- Action buttons: Edit for owner/admin, Report for others -->
              <div class="d-flex align-items-center gap-2">
                <% if (isOwner || isAdmin) { %>
                  <a href="/experiences/<%= experience._id %>/edit" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-edit me-1"></i>Edit
                  </a>
                <% } %>
                <% if (!isOwner) { %>
                  <% if (locals.user) { %>
                    <button type="button" class="btn btn-outline-danger btn-sm" id="openReportBtn" data-bs-toggle="modal" data-bs-target="#reportModal">
                      <i class="fas fa-flag me-1"></i>Report
                    </button>
                  <% } else { %>
                    <a href="/user/signin" class="btn btn-outline-secondary btn-sm">
                      <i class="fas fa-flag me-1"></i>Report
                    </a>
                  <% } %>
                <% } %>
              </div>
            </div>

          </div>
        </div>

        <!-- Overall Story (if provided) -->
        <% if (experience.body && experience.body.trim()) { %>
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
              <h3 class="h5 fw-bold text-dark mb-3">
                <i class="fas fa-book-open me-2 text-info"></i>Journey & Mindset
              </h3>
              <div class="pre-wrap-text text-secondary">
                <%= experience.body %>
              </div>
            </div>
          </div>
        <% } %>

        <!-- Interview Rounds Timeline -->
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body p-4">
            <h3 class="h5 fw-bold text-dark mb-4">
              <i class="fas fa-stream me-2 text-primary"></i>Interview Rounds (<%= (experience.experience?.rounds || []).length %>)
            </h3>

            <% const rounds = experience.experience?.rounds || []; %>
            <% if (rounds.length === 0) { %>
              <p class="text-muted mb-0">No specific round breakdown was entered for this experience.</p>
            <% } else { %>
              <div class="experience-timeline">
                <% rounds.forEach(function(round, idx) { %>
                  <div class="timeline-step">
                    <div class="timeline-node">
                      <%= round.roundNumber || (idx + 1) %>
                    </div>
                    <div>
                      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <h4 class="h6 fw-bold mb-0 text-dark">
                          <%= round.name %>
                        </h4>
                        <span class="badge bg-light text-primary border text-capitalize">
                          <%= round.type %>
                        </span>
                        <% if (round.durationMinutes) { %>
                          <small class="text-muted">
                            <i class="fas fa-clock me-1"></i><%= round.durationMinutes %> mins
                          </small>
                        <% } %>
                        <% if (round.difficulty) { %>
                          <small class="text-muted">
                            <i class="fas fa-tachometer-alt me-1"></i>Difficulty: <%= round.difficulty %>/5
                          </small>
                        <% } %>
                      </div>

                      <% if (round.description && round.description.trim()) { %>
                        <div class="pre-wrap-text text-secondary mb-3 small">
                          <%= round.description %>
                        </div>
                      <% } %>

                      <!-- Questions asked in this round -->
                      <% const questions = round.questions || []; %>
                      <% if (questions.length > 0) { %>
                        <div class="bg-light rounded p-3 mt-2 border">
                          <h5 class="small fw-bold text-secondary mb-2">
                            <i class="fas fa-question-circle me-1 text-primary"></i>Questions Encountered:
                          </h5>
                          <ul class="list-unstyled mb-0 ps-2">
                            <% questions.forEach(function(q) { %>
                              <li class="mb-1 d-flex align-items-start gap-2 small">
                                <span class="text-primary fw-bold">&bull;</span>
                                <span class="pre-wrap-text text-dark"><%= q %></span>
                              </li>
                            <% }); %>
                          </ul>
                        </div>
                      <% } %>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Tips for Candidates -->
        <% if (experience.experience?.tips && experience.experience.tips.trim()) { %>
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
              <h3 class="h5 fw-bold text-dark mb-3">
                <i class="fas fa-lightbulb me-2 text-warning"></i>Advice & Tips for Juniors
              </h3>
              <div class="pre-wrap-text text-secondary">
                <%= experience.experience.tips %>
              </div>
            </div>
          </div>
        <% } %>

        <!-- Comments Section -->
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body p-4">
            <h3 class="h5 fw-bold text-dark mb-4">
              <i class="fas fa-comments me-2 text-primary"></i>Community Discussion (<%= comments.length %>)
            </h3>

            <!-- Comment Form -->
            <% if (locals.user) { %>
              <form action="/blog/comment/<%= experience._id %>" method="POST" class="mb-4">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                <div class="mb-3">
                  <textarea
                    name="content"
                    rows="3"
                    class="form-control"
                    placeholder="Ask a question or congratulate the candidate..."
                    required
                  ></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-sm px-3">
                  <i class="fas fa-comment me-1"></i>Post Comment
                </button>
              </form>
            <% } else { %>
              <div class="alert alert-light border mb-4">
                <i class="fas fa-sign-in-alt me-2 text-primary"></i>
                <a href="/user/signin" class="fw-semibold">Sign in</a> to join the conversation and ask questions about this interview experience.
              </div>
            <% } %>

            <!-- Comments List -->
            <% if (comments.length === 0) { %>
              <p class="text-muted mb-0">No comments yet. Be the first to ask a question!</p>
            <% } else { %>
              <div class="d-flex flex-column gap-3">
                <% comments.forEach(function(c) { %>
                  <div class="d-flex align-items-start gap-3 p-3 bg-light rounded border">
                    <img
                      src="<%= c.authorAvatar %>"
                      alt="User Avatar"
                      class="rounded-circle flex-shrink-0 avatar-img"
                      width="40"
                      height="40"
                    >
                    <div class="flex-grow-1">
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <div>
                          <span class="fw-bold"><%= c.authorName %></span>
                          <% if (c.isAuthorBadge) { %>
                            <span class="badge bg-primary ms-1">Original Poster</span>
                          <% } %>
                        </div>
                        <small class="text-muted">
                          <%= new Date(c.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                        </small>
                      </div>
                      <div class="pre-wrap-text text-secondary small">
                        <%= c.content %>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } %>

          </div>
        </div>

      </div>
    </div>
  </div>

  <% if (locals.user && !isOwner) { %>
    <!-- Report Modal -->
    <div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <form id="reportForm" action="/experiences/<%= experience._id %>/report" method="POST">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <div class="modal-header">
              <h5 class="modal-title" id="reportModalLabel">
                <i class="fas fa-flag text-danger me-2"></i>Report Experience
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div id="reportAlert" class="alert alert-danger d-none" role="alert"></div>
              <div class="mb-3">
                <label for="reportReason" class="form-label fw-semibold">Reason for Report *</label>
                <select name="reason" id="reportReason" class="form-select" required>
                  <option value="">Select a reason...</option>
                  <option value="spam">Spam or advertising</option>
                  <option value="promotional">Promotional content</option>
                  <option value="personal-info">Contains personal contact info / real names</option>
                  <option value="abusive">Abusive or hateful language</option>
                  <option value="fake">Fake or misleading experience</option>
                  <option value="other">Other policy violation</option>
                </select>
              </div>
              <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label for="reportNote" class="form-label fw-semibold mb-0">Additional Details (Optional)</label>
                  <small class="text-muted" id="reportNoteCounter">0 / 300</small>
                </div>
                <textarea name="note" id="reportNote" class="form-control" rows="3" maxlength="300" placeholder="Provide extra context if needed..."></textarea>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" id="submitReportBtn" class="btn btn-danger">Submit Report</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    <script src="/js/report.js" defer></script>
  <% } %>

  <%- include("../partials/scripts") %>
</body>
</html>


<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Share Interview Experience - Blogify</title>
</head>
<body>
  <%- include("../partials/nav") %>

  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="text-center mb-4">
          <h1 class="blog-title">
            <i class="fas fa-briefcase me-3 text-primary"></i>Share Interview Experience
          </h1>
          <p class="hero-subtitle">Help future candidates navigate placements and internship drives</p>
        </div>

        <% if (locals.errors && locals.errors.general) { %>
          <div class="alert alert-danger" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i><%= errors.general %>
          </div>
        <% } %>

        <% if (locals.aiStructureEnabled) { %>
          <!-- AI Assisted Structuring Collapsible Panel -->
          <div class="card shadow-sm border-0 mb-4 ai-notes-panel">
            <div class="card-header bg-primary-subtle border-0 py-3">
              <button
                class="btn btn-link text-decoration-none text-dark fw-bold w-100 text-start p-0 d-flex justify-content-between align-items-center"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#aiStructureCollapse"
                aria-expanded="false"
                aria-controls="aiStructureCollapse"
                id="toggleAiStructureBtn"
              >
                <span>
                  <i class="fas fa-magic text-primary me-2"></i>Have rough notes? Let AI fill the form
                </span>
                <i class="fas fa-chevron-down text-muted"></i>
              </button>
            </div>
            <div class="collapse" id="aiStructureCollapse">
              <div class="card-body p-4">
                <div class="mb-3">
                  <label for="aiNotesInput" class="form-label fw-semibold">
                    Paste your raw notes from WhatsApp, Google Docs, or memory
                  </label>
                  <textarea
                    class="form-control"
                    id="aiNotesInput"
                    name="aiNotes"
                    rows="6"
                    maxlength="6000"
                    placeholder="e.g. Amazon visited our campus for SDE-1 in August 2024. Round 1 was an online test on HackerEarth with 2 coding questions on DP and trees. Round 2 was technical with questions on OS and projects..."
                  ></textarea>
                  <div class="d-flex justify-content-between align-items-center mt-1">
                    <small class="text-muted">Minimum 80 characters</small>
                    <small id="aiNotesCharCounter" class="text-muted">0 / 6000</small>
                  </div>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                  <button
                    type="button"
                    class="btn btn-primary"
                    id="btnStructureNotes"
                  >
                    <i class="fas fa-magic me-2"></i>Structure with AI
                  </button>
                  <p class="text-muted small mb-0 flex-grow-1 ms-md-3">
                    <i class="fas fa-shield-alt text-success me-1"></i>
                    Your notes are sent to our AI provider (Groq) to structure them. Obvious phone numbers, emails and links are removed first. Please do not include interviewer names or contact details. Blogify does not save your notes.
                  </p>
                </div>

                <div id="aiStructureStatus" class="mt-3" aria-live="polite"></div>
              </div>
            </div>
          </div>
        <% } %>

        <!-- AI Filled Success Banner -->
        <div id="aiFilledBanner" class="alert alert-info alert-dismissible fade show d-none mb-4" role="alert">
          <div class="d-flex">
            <i class="fas fa-magic fa-lg me-3 mt-1 text-primary"></i>
            <div>
              <p class="mb-1 fw-semibold" id="aiFilledBannerText">
                AI filled these fields. Check everything and fix mistakes before posting. Difficulty is always chosen by you.
              </p>
              <div id="aiFilledBannerMeta" class="small text-muted"></div>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <div class="card shadow-sm border-0">
          <div class="card-body p-4 p-md-5">
            <form action="/experiences" method="POST" id="experienceForm">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

              <!-- Company & Role -->
              <div class="row g-3 mb-4">
                <div class="col-md-6">
                  <label for="companyInput" class="form-label fw-semibold">
                    <i class="fas fa-building me-1 text-primary"></i>Company Name <span class="text-danger">*</span>
                  </label>
                  <input
                    type="text"
                    name="company"
                    id="companyInput"
                    class="form-control <%= errors.company ? 'is-invalid' : '' %>"
                    placeholder="e.g. Google, Microsoft, TCS"
                    list="companyList"
                    value="<%= formData.company || '' %>"
                    required
                  >
                  <datalist id="companyList">
                    <% (companies || []).forEach(function(c) { %>
                      <option value="<%= c.name %>"></option>
                    <% }); %>
                  </datalist>
                  <div id="companyNewHint" class="form-text text-muted mt-1"></div>
                  <% if (errors.company) { %>
                    <div class="invalid-feedback"><%= errors.company %></div>
                  <% } %>
                </div>

                <div class="col-md-6">
                  <label for="roleInput" class="form-label fw-semibold">
                    <i class="fas fa-id-badge me-1 text-primary"></i>Role / Profile <span class="text-danger">*</span>
                  </label>
                  <input
                    type="text"
                    name="role"
                    id="roleInput"
                    maxlength="100"
                    class="form-control <%= errors.role ? 'is-invalid' : '' %>"
                    placeholder="e.g. Software Engineer, SDE Intern"
                    value="<%= formData.role || '' %>"
                    required
                  >
                  <% if (errors.role) { %>
                    <div class="invalid-feedback"><%= errors.role %></div>
                  <% } %>
                </div>
              </div>

              <!-- Drive Type, Year, Difficulty, Outcome -->
              <div class="row g-3 mb-4">
                <div class="col-md-3 col-sm-6">
                  <label for="driveTypeSelect" class="form-label fw-semibold">
                    <i class="fas fa-graduation-cap me-1 text-primary"></i>Drive Type <span class="text-danger">*</span>
                  </label>
                  <select name="driveType" id="driveTypeSelect" class="form-select <%= errors.driveType ? 'is-invalid' : '' %>" required>
                    <option value="">Select...</option>
                    <option value="on-campus" <%= formData.driveType === 'on-campus' ? 'selected' : '' %>>On-Campus</option>
                    <option value="off-campus" <%= formData.driveType === 'off-campus' ? 'selected' : '' %>>Off-Campus</option>
                    <option value="internship" <%= formData.driveType === 'internship' ? 'selected' : '' %>>Internship</option>
                  </select>
                  <% if (errors.driveType) { %>
                    <div class="invalid-feedback"><%= errors.driveType %></div>
                  <% } %>
                </div>

                <div class="col-md-3 col-sm-6">
                  <label for="yearInput" class="form-label fw-semibold">
                    <i class="fas fa-calendar me-1 text-primary"></i>Year <span class="text-danger">*</span>
                  </label>
                  <% const currentYr = new Date().getFullYear(); %>
                  <input
                    type="number"
                    name="year"
                    id="yearInput"
                    min="2015"
                    max="<%= currentYr + 1 %>"
                    class="form-control <%= errors.year ? 'is-invalid' : '' %>"
                    value="<%= formData.year || currentYr %>"
                    required
                  >
                  <% if (errors.year) { %>
                    <div class="invalid-feedback"><%= errors.year %></div>
                  <% } %>
                </div>

                <div class="col-md-3 col-sm-6">
                  <label for="diffSelect" class="form-label fw-semibold">
                    <i class="fas fa-tachometer-alt me-1 text-primary"></i>Difficulty (1-5) <span class="text-danger">*</span>
                  </label>
                  <select name="difficulty" id="diffSelect" class="form-select <%= errors.difficulty ? 'is-invalid' : '' %>" required>
                    <option value="">Select...</option>
                    <option value="1" <%= formData.difficulty == 1 ? 'selected' : '' %>>1 - Very Easy</option>
                    <option value="2" <%= formData.difficulty == 2 ? 'selected' : '' %>>2 - Easy</option>
                    <option value="3" <%= formData.difficulty == 3 ? 'selected' : '' %>>3 - Medium</option>
                    <option value="4" <%= formData.difficulty == 4 ? 'selected' : '' %>>4 - Hard</option>
                    <option value="5" <%= formData.difficulty == 5 ? 'selected' : '' %>>5 - Very Hard</option>
                  </select>
                  <% if (errors.difficulty) { %>
                    <div class="invalid-feedback"><%= errors.difficulty %></div>
                  <% } %>
                </div>

                <div class="col-md-3 col-sm-6">
                  <label for="outcomeSelect" class="form-label fw-semibold">
                    <i class="fas fa-flag-checkered me-1 text-primary"></i>Outcome <span class="text-danger">*</span>
                  </label>
                  <select name="outcome" id="outcomeSelect" class="form-select <%= errors.outcome ? 'is-invalid' : '' %>" required>
                    <option value="selected" <%= formData.outcome === 'selected' ? 'selected' : '' %>>Selected 🎉</option>
                    <option value="rejected" <%= formData.outcome === 'rejected' ? 'selected' : '' %>>Rejected</option>
                    <option value="waiting" <%= formData.outcome === 'waiting' ? 'selected' : '' %>>Waiting</option>
                    <option value="undisclosed" <%= !formData.outcome || formData.outcome === 'undisclosed' ? 'selected' : '' %>>Undisclosed</option>
                  </select>
                  <% if (errors.outcome) { %>
                    <div class="invalid-feedback"><%= errors.outcome %></div>
                  <% } %>
                </div>
              </div>

              <!-- Interview Rounds Section -->
              <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h4 class="h5 fw-bold mb-0">
                    <i class="fas fa-list-ol me-2 text-primary"></i>Interview Rounds (Max 10)
                  </h4>
                  <button type="button" class="btn btn-sm btn-outline-primary" id="addRoundBtn">
                    <i class="fas fa-plus me-1"></i>Add Another Round
                  </button>
                </div>
                <% if (errors.rounds) { %>
                  <div class="alert alert-danger py-2 small mb-3"><%= errors.rounds %></div>
                <% } %>

                <div id="roundsContainer">
                  <% 
                    let preservedRounds = [];
                    if (Array.isArray(formData.rounds)) {
                      preservedRounds = formData.rounds.filter(r => r && typeof r === 'object');
                    } else if (typeof formData.rounds === 'object' && formData.rounds !== null) {
                      preservedRounds = Object.values(formData.rounds).filter(r => r && typeof r === 'object');
                    }
                  %>
                  <% if (preservedRounds.length > 0) { %>
                    <% preservedRounds.forEach(function(r, rIdx) { %>
                      <div class="round-card">
                        <div class="round-card-header">
                          <span class="round-number-badge">Round <%= rIdx + 1 %></span>
                          <button type="button" class="btn btn-sm btn-outline-danger btn-remove-round" title="Remove Round">
                            <i class="fas fa-trash me-1"></i>Remove
                          </button>
                        </div>

                        <div class="row g-3 mb-3">
                          <div class="col-md-5">
                            <label class="form-label small fw-semibold">Round Name *</label>
                            <input
                              type="text"
                              name="rounds[<%= rIdx %>][name]"
                              data-field="name"
                              class="form-control form-control-sm <%= errors['round_' + rIdx + '_name'] ? 'is-invalid' : '' %>"
                              placeholder="e.g. Online Assessment, Tech 1"
                              value="<%= r.name || '' %>"
                              required
                            >
                            <% if (errors['round_' + rIdx + '_name']) { %>
                              <div class="invalid-feedback"><%= errors['round_' + rIdx + '_name'] %></div>
                            <% } %>
                          </div>

                          <div class="col-md-3">
                            <label class="form-label small fw-semibold">Round Type *</label>
                            <select name="rounds[<%= rIdx %>][type]" data-field="type" class="form-select form-select-sm <%= errors['round_' + rIdx + '_type'] ? 'is-invalid' : '' %>" required>
                              <option value="aptitude" <%= r.type === 'aptitude' ? 'selected' : '' %>>Aptitude</option>
                              <option value="coding" <%= r.type === 'coding' ? 'selected' : '' %>>Coding</option>
                              <option value="technical" <%= !r.type || r.type === 'technical' ? 'selected' : '' %>>Technical</option>
                              <option value="managerial" <%= r.type === 'managerial' ? 'selected' : '' %>>Managerial</option>
                              <option value="hr" <%= r.type === 'hr' ? 'selected' : '' %>>HR</option>
                              <option value="group-discussion" <%= r.type === 'group-discussion' ? 'selected' : '' %>>Group Discussion</option>
                              <option value="other" <%= r.type === 'other' ? 'selected' : '' %>>Other</option>
                            </select>
                            <% if (errors['round_' + rIdx + '_type']) { %>
                              <div class="invalid-feedback"><%= errors['round_' + rIdx + '_type'] %></div>
                            <% } %>
                          </div>

                          <div class="col-md-2 col-6">
                            <label class="form-label small fw-semibold">Duration (min)</label>
                            <input
                              type="number"
                              name="rounds[<%= rIdx %>][durationMinutes]"
                              data-field="durationMinutes"
                              min="0"
                              class="form-control form-control-sm"
                              placeholder="60"
                              value="<%= r.durationMinutes || '' %>"
                            >
                          </div>

                          <div class="col-md-2 col-6">
                            <label class="form-label small fw-semibold">Difficulty (1-5)</label>
                            <select name="rounds[<%= rIdx %>][difficulty]" data-field="difficulty" class="form-select form-select-sm">
                              <option value="">Optional</option>
                              <option value="1" <%= r.difficulty == 1 ? 'selected' : '' %>>1</option>
                              <option value="2" <%= r.difficulty == 2 ? 'selected' : '' %>>2</option>
                              <option value="3" <%= r.difficulty == 3 ? 'selected' : '' %>>3</option>
                              <option value="4" <%= r.difficulty == 4 ? 'selected' : '' %>>4</option>
                              <option value="5" <%= r.difficulty == 5 ? 'selected' : '' %>>5</option>
                            </select>
                          </div>
                        </div>

                        <div class="mb-3">
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-semibold mb-0">Round Description & Experience</label>
                            <small class="text-muted char-counter-desc">0 / 1000</small>
                          </div>
                          <textarea
                            name="rounds[<%= rIdx %>][description]"
                            data-field="description"
                            rows="3"
                            maxlength="1000"
                            class="form-control form-control-sm <%= errors['round_' + rIdx + '_description'] ? 'is-invalid' : '' %>"
                            placeholder="What happened in this round? Topics asked, interviewer tone, etc..."
                          ><%= r.description || '' %></textarea>
                          <% if (errors['round_' + rIdx + '_description']) { %>
                            <div class="invalid-feedback"><%= errors['round_' + rIdx + '_description'] %></div>
                          <% } %>
                        </div>

                        <!-- Questions in this round -->
                        <div class="questions-container">
                          <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small fw-semibold text-secondary mb-0">
                              <i class="fas fa-question-circle me-1"></i>Questions Asked (Max 15)
                            </label>
                            <button type="button" class="btn btn-xs btn-outline-secondary btn-add-question">
                              <i class="fas fa-plus me-1"></i>Add Question
                            </button>
                          </div>
                          <div class="questions-list">
                            <% 
                              let presQ = [];
                              if (Array.isArray(r.questions)) {
                                presQ = r.questions;
                              } else if (typeof r.questions === 'object' && r.questions !== null) {
                                presQ = Object.values(r.questions);
                              }
                            %>
                            <% if (presQ.length > 0) { %>
                              <% presQ.forEach(function(qVal, qIdx) { %>
                                <div class="input-group input-group-sm mb-2 question-item">
                                  <input
                                    type="text"
                                    name="rounds[<%= rIdx %>][questions][<%= qIdx %>]"
                                    class="form-control question-input"
                                    maxlength="300"
                                    placeholder="e.g. Reverse a linked list, Explain ACID properties..."
                                    value="<%= typeof qVal === 'string' ? qVal : (qVal?.text || '') %>"
                                  >
                                  <button type="button" class="btn btn-outline-danger btn-remove-question" title="Remove question">
                                    <i class="fas fa-times"></i>
                                  </button>
                                </div>
                              <% }); %>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    <% }); %>
                  <% } %>
                </div>
              </div>

              <!-- Tips & Strategy -->
              <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label for="tipsInput" class="form-label fw-semibold mb-0">
                    <i class="fas fa-lightbulb me-1 text-warning"></i>Tips for Juniors (Max 2000 chars)
                  </label>
                  <small class="text-muted" id="tipsCounter">0 / 2000</small>
                </div>
                <textarea
                  name="tips"
                  id="tipsInput"
                  rows="4"
                  maxlength="2000"
                  class="form-control <%= errors.tips ? 'is-invalid' : '' %>"
                  placeholder="What resources helped you? What should juniors prepare or avoid?"
                ><%= formData.tips || '' %></textarea>
                <% if (errors.tips) { %>
                  <div class="invalid-feedback"><%= errors.tips %></div>
                <% } %>
              </div>

              <!-- Overall Story (Saved in body) -->
              <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label for="storyInput" class="form-label fw-semibold mb-0">
                    <i class="fas fa-book-open me-1 text-info"></i>Overall Story / Journey (Optional, Max 5000 chars)
                  </label>
                  <small class="text-muted" id="storyCounter">0 / 5000</small>
                </div>
                <textarea
                  name="story"
                  id="storyInput"
                  rows="5"
                  maxlength="5000"
                  class="form-control <%= errors.story ? 'is-invalid' : '' %>"
                  placeholder="Share your overall placement journey, mindset, feelings, or background context..."
                ><%= formData.story || '' %></textarea>
                <% if (errors.story) { %>
                  <div class="invalid-feedback"><%= errors.story %></div>
                <% } %>
              </div>

              <!-- Privacy & Verification Checkboxes -->
              <div class="border rounded p-3 mb-4 bg-light">
                <div class="form-check mb-2">
                  <input
                    type="checkbox"
                    name="anonymous"
                    id="anonymousCheck"
                    class="form-check-input"
                    <%= formData.anonymous === 'on' || formData.anonymous === true || formData.anonymous === 'true' ? 'checked' : '' %>
                  >
                  <label for="anonymousCheck" class="form-check-label fw-semibold">
                    <i class="fas fa-user-secret me-1 text-secondary"></i>Post Anonymously
                  </label>
                  <div class="small text-muted">
                    Your real name and avatar will be hidden across all public feeds and cards.
                  </div>
                </div>

                <hr class="my-2 text-muted">

                <div class="form-check">
                  <input
                    type="checkbox"
                    name="noContactDetails"
                    id="noContactCheck"
                    class="form-check-input <%= errors.noContactDetails ? 'is-invalid' : '' %>"
                    <%= formData.noContactDetails === 'on' || formData.noContactDetails === true || formData.noContactDetails === 'true' ? 'checked' : '' %>
                    required
                  >
                  <label for="noContactCheck" class="form-check-label fw-semibold text-danger">
                    I confirm that I have NOT included interviewer names, emails, phone numbers, or private contact details *
                  </label>
                  <% if (errors.noContactDetails) { %>
                    <div class="invalid-feedback d-block"><%= errors.noContactDetails %></div>
                  <% } %>
                </div>
              </div>

              <!-- Submit Buttons -->
              <div class="d-flex justify-content-between align-items-center">
                <a href="/" class="btn btn-outline-secondary">
                  <i class="fas fa-arrow-left me-1"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary btn-lg px-4" id="submitExpBtn">
                  <i class="fas fa-paper-plane me-2"></i>Publish Experience
                </button>
              </div>

            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- HTML Templates for Dynamic Client-Side Duplication (CSP Compliant) -->
  <template id="roundTemplate">
    <div class="round-card">
      <div class="round-card-header">
        <span class="round-number-badge">Round 1</span>
        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-round" title="Remove Round">
          <i class="fas fa-trash me-1"></i>Remove
        </button>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-5">
          <label class="form-label small fw-semibold">Round Name *</label>
          <input
            type="text"
            data-field="name"
            class="form-control form-control-sm"
            placeholder="e.g. Online Assessment, Tech 1"
            required
          >
        </div>

        <div class="col-md-3">
          <label class="form-label small fw-semibold">Round Type *</label>
          <select data-field="type" class="form-select form-select-sm" required>
            <option value="aptitude">Aptitude</option>
            <option value="coding">Coding</option>
            <option value="technical" selected>Technical</option>
            <option value="managerial">Managerial</option>
            <option value="hr">HR</option>
            <option value="group-discussion">Group Discussion</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="col-md-2 col-6">
          <label class="form-label small fw-semibold">Duration (min)</label>
          <input
            type="number"
            data-field="durationMinutes"
            min="0"
            class="form-control form-control-sm"
            placeholder="60"
          >
        </div>

        <div class="col-md-2 col-6">
          <label class="form-label small fw-semibold">Difficulty (1-5)</label>
          <select data-field="difficulty" class="form-select form-select-sm">
            <option value="">Optional</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
          </select>
        </div>
      </div>

      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label class="form-label small fw-semibold mb-0">Round Description & Experience</label>
          <small class="text-muted char-counter-desc">0 / 1000</small>
        </div>
        <textarea
          data-field="description"
          rows="3"
          maxlength="1000"
          class="form-control form-control-sm"
          placeholder="What happened in this round? Topics asked, interviewer tone, etc..."
        ></textarea>
      </div>

      <div class="questions-container">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <label class="form-label small fw-semibold text-secondary mb-0">
            <i class="fas fa-question-circle me-1"></i>Questions Asked (Max 15)
          </label>
          <button type="button" class="btn btn-xs btn-outline-secondary btn-add-question">
            <i class="fas fa-plus me-1"></i>Add Question
          </button>
        </div>
        <div class="questions-list">
          <div class="input-group input-group-sm mb-2 question-item">
            <input
              type="text"
              class="form-control question-input"
              maxlength="300"
              placeholder="e.g. Reverse a linked list, Explain ACID properties..."
            >
            <button type="button" class="btn btn-outline-danger btn-remove-question" title="Remove question">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </template>

  <template id="questionTemplate">
    <div class="input-group input-group-sm mb-2 question-item">
      <input
        type="text"
        class="form-control question-input"
        maxlength="300"
        placeholder="e.g. Write an SQL query for second highest salary..."
      >
      <button type="button" class="btn btn-outline-danger btn-remove-question" title="Remove question">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </template>

  <%- include("../partials/scripts") %>
  <script src="/js/experience-form.js" defer></script>
  <% if (locals.aiStructureEnabled) { %>
    <script src="/js/experience-structure.js" defer></script>
  <% } %>
</body>
</html>

